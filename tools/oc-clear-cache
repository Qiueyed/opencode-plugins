#!/bin/zsh
# oc-clear-cache: wipe the OpenCode desktop app's renderer caches.
# Run this from Terminal while OpenCode is FULLY QUIT (Cmd+Q), then relaunch.
# Deletes ONLY regenerable cache dirs - nothing else is touched.
set -euo pipefail
D="$HOME/Library/Application Support/ai.opencode.desktop"
if pgrep -f "OpenCode.app/Contents/MacOS/OpenCode$" >/dev/null 2>&1; then
  echo "OpenCode is still RUNNING. Quit it first (Cmd+Q), then re-run this."
  exit 1
fi
for sub in "Cache" "Code Cache" "GPUCache" "DawnCache"; do
  if [ -d "$D/$sub" ]; then
    /bin/rm -rf "$D/$sub"
    echo "removed: $D/$sub"
  fi
done
echo "done. Launch OpenCode now - it will fetch every asset fresh."
