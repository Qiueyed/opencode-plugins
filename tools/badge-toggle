#!/bin/bash
# badge-toggle <ctx|img|cost> - flip a model-row badge flag (state.json,
# the Plugins-menu checkbox backend) AND re-patch the app via oc-ui badge.
# The new badge visibility loads at next app restart (oc-ui reminds you).
set -euo pipefail
FAMILY="${1:?usage: badge-toggle <ctx|img|cost>}"
case "$FAMILY" in ctx|img|cost) ;; *) echo "unknown badge family: $FAMILY" >&2; exit 2 ;; esac
D="$HOME/.config/opencode"
case "$FAMILY" in
  ctx)  KEY="ocBadgeCtx"  ;;
  img)  KEY="ocBadgeImg"  ;;
  cost) KEY="ocBadgeCost" ;;
esac
raw="$(sh "$D/tools/state-toggle" "$KEY")"
# state-toggle prints Python-style True/False; match case-insensitively
case "$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')" in
  *true*)  v="on"  ;;
  *false*) v="off" ;;
  *) echo "could not parse state-toggle output: $raw" >&2; exit 1 ;;
esac
exec zsh "$D/patches/oc-ui" badge "$FAMILY" "$v"
