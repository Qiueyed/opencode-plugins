#!/bin/zsh
# oc-post-update: run ALL app-bundle patchers after an OpenCode desktop update.
# Fail-fast: stops at the first patcher that refuses (anchor drift) so a bad
# port never ships half-applied. Run AFTER applying an update via
# oc-update-118, then quit + relaunch the app, then run oc-update-118 verify.
# Output is unfiltered and the exit status is taken from node itself (never
# from a pipe - class-5 rule).
set -u
P="$HOME/.config/opencode/patches"
for f in patch-opencode-desktop-ui.mjs patch-opencode-session-menu.mjs patch-opencode-edit-candidates.mjs patch-opencode-image-capability.mjs; do
  print "── $f"
  out="$(node "$P/$f" 2>&1)"
  st=$?
  print -r -- "$out"
  if (( st != 0 )); then
    print "FAILED: $f (exit $st) - fix or --revert before continuing. Remaining patchers skipped."
    exit 1
  fi
done
print "\nRESULT: all 4 patchers applied. Quit + reopen OpenCode, then: oc-update-118 verify"
